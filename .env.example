# Frontend Next.js — copie para .env.local e ajuste.
# O frontend não fala com o banco: tudo passa pela API NestJS.

# Base da API NestJS vista pelo servidor Next (em Docker: http://backend:4000).
BACKEND_URL=http://localhost:4000

# Cookies de sessão com flag Secure. Deixe true em produção (HTTPS).
COOKIE_SECURE=false

# --- Usado apenas pelo docker-compose da raiz -------------------------------
POSTGRES_USER=dashstudy
POSTGRES_PASSWORD=dashstudy
POSTGRES_DB=dashstudy
POSTGRES_PORT=5432

BACKEND_PORT=4000
FRONTEND_PORT=3000

JWT_SECRET=troque-por-um-segredo-longo-de-no-minimo-32-chars
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
