# Backend NestJS — copie para .env e ajuste.

NODE_ENV=development
PORT=4000

# Postgres. Em Docker use o host `db`; local, `localhost`.
DATABASE_URL=postgresql://dashstudy:dashstudy@localhost:5432/dashstudy?schema=public

# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-de-no-minimo-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Origens autorizadas no CORS, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
MAX_BODY_BYTES=524288

# SMTP opcional. Sem SMTP_HOST, o link de reset é logado no console (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dash Estudos <noreply@dashstudy.com>"

# OAuth GitHub (opcional). Sem as credenciais, a rota devolve 503.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# Upload de anexos do chat (Vercel Blob) e busca de GIFs (Tenor).
BLOB_READ_WRITE_TOKEN=
TENOR_API_KEY=
